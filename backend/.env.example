# Razorpay TEST/SANDBOX credentials only for initial testing.
# Never commit a real secret to GitHub or put it in index.html/app.js.
PORT=8080
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Create one Razorpay Subscription Plan per frequency in the Razorpay dashboard/API.
RAZORPAY_PLAN_DAILY_ID=plan_test_daily_xxx
RAZORPAY_PLAN_WEEKLY_ID=plan_test_weekly_xxx
RAZORPAY_PLAN_MONTHLY_ID=plan_test_monthly_xxx
# Set this only after the backend is deployed over HTTPS and verified.
ALLOWED_ORIGIN=http://localhost:8080
