# Razorpay TEST/SANDBOX credentials only for initial testing.
# Never commit a real secret to GitHub or put it in index.html/app.js.
PORT=8080
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Create one Razorpay Subscription Plan per frequency in the Razorpay dashboard/API.
RAZORPAY_PLAN_DAILY_ID=plan_test_daily_xxx
RAZORPAY_PLAN_WEEKLY_ID=plan_test_weekly_xxx
RAZORPAY_PLAN_MONTHLY_ID=plan_test_monthly_xxx
# Set this only after the backend is deployed over HTTPS and verified.
ALLOWED_ORIGIN=http://localhost:8080

# Vendor Portal > Settings > Helpline / Support form emails go to SUPPORT_EMAIL.
# Sending needs a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords).
# Never share or commit the real .env file.
SUPPORT_EMAIL=onthewaynpr@gmail.com
GMAIL_USER=onthewaynpr@gmail.com
GMAIL_APP_PASSWORD=replace_with_16_character_gmail_app_password
# Using a different mail provider instead of Gmail? Fill these in (they take priority over the Gmail settings):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=support@example.com
# SMTP_PASS=your_smtp_password
